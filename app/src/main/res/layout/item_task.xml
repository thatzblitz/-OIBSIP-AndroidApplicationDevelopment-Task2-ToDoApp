<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Task Name -->
        <TextView
            android:id="@+id/textTaskName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Task Name Template"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/android:textColorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/switchCompletion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="12dp"/>

        <!-- Completion Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCompletion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:useMaterialThemeColors="false"
            app:trackTint="@color/switch_red"
            app:thumbTint="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/textDateTime"/>

        <!-- Date & Time -->
        <TextView
            android:id="@+id/textDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mon-Fri, 7:00 am"
            android:textSize="14sp"
            android:textColor="@color/text_secondary_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/switchCompletion"
            app:layout_constraintTop_toBottomOf="@+id/textTaskName" />

        <!-- Description -->
        <TextView
            android:id="@+id/textDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This is a detailed description of the task that might span multiple lines but will be truncated..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary_dark"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textDateTime" />

        <!-- Show More Button -->
        <TextView
            android:id="@+id/textShowMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="...show more"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>